{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"defaultMode": "acceptEdits",
		"allow": [
			"Read(<RUTA_PROYECTO>/**)",
			"Edit(<RUTA_PROYECTO>/**)",
			"Write(<RUTA_PROYECTO>/**)",
			"Read(<HOME>/.cache/video-editor/**)",
			"Read(<HOME>/.claude/projects/<PROYECTO_CODIFICADO>/memory/**)",
			"Edit(<HOME>/.claude/projects/<PROYECTO_CODIFICADO>/memory/**)",
			"Write(<HOME>/.claude/projects/<PROYECTO_CODIFICADO>/memory/**)",
			"Read(//tmp/**)",
			"Write(//tmp/**)",

			"Bash(source:*)",
			"Bash(nvm:*)",
			"Bash(node:*)",
			"Bash(npm:*)",
			"Bash(npx:*)",
			"Bash(python3:*)",
			"Bash(ffmpeg:*)",
			"Bash(ffprobe:*)",
			"Bash(yt-dlp:*)",
			"Bash(sh tools/architect/biblioteca/fuentes/*)",
			"Bash(sh biblioteca/fuentes/*)",

			"Bash(cd:*)",
			"Bash(ls:*)",
			"Bash(cat:*)",
			"Bash(head:*)",
			"Bash(tail:*)",
			"Bash(wc:*)",
			"Bash(grep:*)",
			"Bash(find:*)",
			"Bash(sort:*)",
			"Bash(uniq:*)",
			"Bash(cut:*)",
			"Bash(tr:*)",
			"Bash(awk:*)",
			"Bash(sed:*)",
			"Bash(jq:*)",
			"Bash(diff:*)",
			"Bash(du:*)",
			"Bash(df:*)",
			"Bash(stat:*)",
			"Bash(file:*)",
			"Bash(test:*)",
			"Bash(echo:*)",
			"Bash(printf:*)",
			"Bash(which:*)",
			"Bash(sha256sum:*)",
			"Bash(identify:*)",
			"Bash(mkdir:*)",
			"Bash(touch:*)",
			"Bash(cp:*)",
			"Bash(mv:*)",
			"Bash(ln:*)",
			"Bash(xdg-open:*)",
			"Bash(curl -s*)",
			"Bash(curl -f*)",

			"WebSearch",
			"mcp__claude-in-chrome__*",
			"WebFetch(domain:www.instagram.com)",
			"WebFetch(domain:github.com)",
			"WebFetch(domain:raw.githubusercontent.com)",
			"WebFetch(domain:en.wikipedia.org)",
			"WebFetch(domain:es.wikipedia.org)",
			"WebFetch(domain:pubmed.ncbi.nlm.nih.gov)",
			"WebFetch(domain:www.ncbi.nlm.nih.gov)",
			"WebFetch(domain:doi.org)",
			"WebFetch(domain:www.remotion.dev)",
			"WebFetch(domain:elevenlabs.io)"
		],
		"ask": [
			"Bash(rm:*)",
			"Bash(sudo:*)",
			"Bash(*--si-gasto*)",
			"Bash(git push:*)"
		],
		"deny": [
			"Read(<HOME>/.config/claude-editor/**)",
			"Read(//**/cookies.txt)"
		]
	},
	"env": {
		"EDITOR_WHISPER_CLI": "<HOME>/.cache/video-editor/whisper/b5454/whisper-bin-ubuntu-x64/whisper-cli",
		"EDITOR_VAD_CLI": "<HOME>/.cache/video-editor/whisper/b5454/whisper-bin-ubuntu-x64/whisper-vad-speech-segments"
	}
}
